<feature-group-spec name="grpc" xmlns="urn:jboss:galleon:feature-group:1.0">
    <feature spec="subsystem.grpc">
        <param name="default-thread-pool" value="default"/>
        <feature spec="subsystem.grpc.thread-pool">
            <param name="thread-pool" value="default" />
            <param name="max-threads" value="10" />
            <feature spec="subsystem.grpc.thread-pool.keepalive-time">
                <param name="time" value="30"/>
                <param name="unit" value="SECONDS"/>
            </feature>
        </feature>
    </feature>
</feature-group-spec>
