<module xmlns="urn:jboss:module:1.9" name="org.wildfly.extension.grpc">

    <properties>
        <property name="jboss.api" value="private"/>
    </properties>

    <resources>
        <artifact name="${org.wildfly:wildfly-grpc}"/>
    </resources>

    <dependencies>
        <module name="com.google.guava"/>
        <module name="io.grpc"/>
        <module name="io.grpc.core"/>
        <module name="io.undertow.core" services="import"/>
        <module name="org.jboss.as.controller"/>
        <module name="org.jboss.as.ee"/>
        <module name="org.jboss.as.server"/>
        <module name="org.jboss.as.threads"/>
        <module name="org.jboss.as.version" />
        <module name="org.jboss.as.web-common"/>
        <module name="org.jboss.jandex"/>
        <module name="org.jboss.logging"/>
        <module name="org.jboss.metadata.common"/>
        <module name="org.jboss.metadata.web"/>
        <module name="org.jboss.modules"/>
        <module name="org.jboss.msc"/>
        <module name="org.jboss.staxmapper"/>
        <module name="org.jboss.xnio"/>
        <module name="org.jboss.xnio.nio" services="import"/>
        <module name="org.wildfly.extension.request-controller" />
        <!-- TODO (jrp) we do need this, but make sure it is this module we need and not some common one -->
        <module name="org.wildfly.extension.undertow"/>
        <module name="org.wildfly.service"/>
        <module name="org.wildfly.subsystem"/>
    </dependencies>
</module>
