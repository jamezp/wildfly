        </dependency>
        <!--Test dependencies -->
        <!-- TODO (jrp) I don't know if this one is needed -->
        <dependency>
            <groupId>org.projectodd.vdx</groupId>
            <artifactId>vdx-wildfly</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wildfly.core</groupId>
