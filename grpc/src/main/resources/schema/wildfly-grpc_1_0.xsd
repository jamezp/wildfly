<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:threads="urn:jboss:domain:threads:1.1"
           targetNamespace="urn:wildfly:grpc:1.0"
           xmlns="urn:wildfly:grpc:1.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0">

    <xs:import namespace="urn:jboss:domain:threads:1.1" schemaLocation="jboss-as-threads_1_1.xsd"/>

    <!-- The subsystem root element -->
    <xs:element name="subsystem" type="grpc-subsystemType"/>

    <xs:complexType name="grpc-subsystemType">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                The configuration of the gRPC subsystem.
            ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="thread-pool" type="thread-poolType" minOccurs="1" maxOccurs="unbounded"/>
            <xs:element name="thread-factory" type="threads:thread-factory" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="default-thread-pool" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="thread-poolType">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                A thread pool executor with an unbounded queue for gRPC async operations.

                The "max-threads" attribute must be used to specify the thread pool size. The nested
                "keepalive-time" element may be used to specify the amount of time that pool threads should
                be kept running when idle; if not specified, threads will run until the executor is shut down.
            ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="max-threads" type="threads:countType"/>
            <xs:element name="keepalive-time" type="threads:time" minOccurs="0"/>
            <xs:element name="thread-factory" type="threads:ref" minOccurs="0"/>
        </xs:all>
        <xs:attribute name="name" use="required" type="xs:string"/>
    </xs:complexType>
</xs:schema>
